# عنوان الموقع الكامل (لرموز QR في PDF وغيرها عند الحاجة خارج المتصفح)
# مثال: https://general-intelligence-service.vercel.app
# NEXT_PUBLIC_SITE_URL=

# ——— الشعار (اختياري) ———
# NEXT_PUBLIC_SITE_LOGO_PATH=
# NEXT_PUBLIC_SITE_LOGO_DARK_PATH=
# NEXT_PUBLIC_PDF_LOGO_PATH=
# NEXT_PUBLIC_SITE_ICON_PATH=

# ——— أمان لوحة التحكم (مهم للإنتاج) ———
# AUTH_SECRET: ضروري في الإنتاج. سلسلة عشوائية 32+ حرفاً:
#   openssl rand -base64 32
AUTH_SECRET=

# الإيميلات المسموح لها بالدخول (مفصولة بفاصلة)
ALLOWED_ADMIN_EMAILS=admin1@example.com,admin2@example.com

# كلمة المرور كهاش bcrypt (مفضّل). ولّدها عبر:
#   node scripts/hash-password.cjs "YourStrongPassword"
ADMIN_PASSWORD_HASH=

# توافق قديم فقط: نص صريح أو هاش bcrypt في ADMIN_PASSWORD
# يُفضّل تركه فارغاً واستخدام ADMIN_PASSWORD_HASH
# ADMIN_PASSWORD=

# كلمات سر لكل حساب: email:bcryptHash أو (مؤقتاً) email:plain
# ADMIN_CREDENTIALS=admin1@example.com:$2a$12$...

# ——— Rate limiting لتسجيل الدخول (Upstash Redis) ———
# أنشئ قاعدة مجانية من https://upstash.com ثم انسخ:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# رفع الصور (Vercel Blob)
# BLOB_READ_WRITE_TOKEN=

# البريد الإلكتروني (إرسال PDF - اختياري)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
ORDER_EMAIL_TO=

# قاعدة البيانات
POSTGRES_URL=
# DATABASE_URL=
